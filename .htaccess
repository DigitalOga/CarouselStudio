

# Carousel Studio: always check for the newest app files
<IfModule mod_headers.c>
  <FilesMatch "(sw\.js|index\.html|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Speed: compress text files and cache static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff|woff2|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
